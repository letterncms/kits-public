  "styles": {
    "body": {
      "fontFamily": "token:font.sans",
      "fontSize": "token:text.base",
      "lineHeight": "token:leading.normal",
      "color": "token:color.foreground",
      "backgroundColor": "token:color.background"
    },
    "h1": {
      "fontFamily": "token:font.display",
      "fontSize": "token:text.5xl",
      "lineHeight": "token:leading.tight",
      "letterSpacing": "token:tracking.tight",
      "fontWeight": "token:weight.medium",
      "textWrap": "balance"
    },
    "h2": {
      "fontFamily": "token:font.display",
      "fontSize": "token:text.4xl",
      "lineHeight": "token:leading.tight",
      "letterSpacing": "token:tracking.tight",
      "fontWeight": "token:weight.medium",
      "textWrap": "balance"
    },
    "h3": {
      "fontFamily": "token:font.display",
      "fontSize": "token:text.2xl",
      "lineHeight": "token:leading.snug",
      "letterSpacing": "token:tracking.snug",
      "fontWeight": "token:weight.medium",
      "textWrap": "balance"
    },
    "h4": {
      "fontSize": "token:text.xl",
      "lineHeight": "token:leading.snug",
      "letterSpacing": "token:tracking.snug",
      "fontWeight": "token:weight.medium"
    },
    "h5": {
      "fontSize": "token:text.lg",
      "lineHeight": "token:leading.snug",
      "fontWeight": "token:weight.medium"
    },
    "h6": {
      "fontSize": "token:text.base",
      "lineHeight": "token:leading.snug",
      "fontWeight": "token:weight.semibold"
    },
    "h1 em": {
      "fontFamily": "token:font.serif",
      "fontStyle": "italic",
      "fontWeight": "token:weight.regular",
      "letterSpacing": "-0.01em"
    },
    "h2 em": {
      "fontFamily": "token:font.serif",
      "fontStyle": "italic",
      "fontWeight": "token:weight.regular",
      "letterSpacing": "-0.01em"
    },
    "h3 em": {
      "fontFamily": "token:font.serif",
      "fontStyle": "italic",
      "fontWeight": "token:weight.regular",
      "letterSpacing": "0"
    },
    "p": {
      "textWrap": "pretty"
    },
    "a": {
      "color": "inherit",
      "textDecorationLine": "underline",
      "textDecorationThickness": "1px",
      "textUnderlineOffset": "0.22em",
      "textDecorationColor": "token:color.foreground/30",
      "transition": "text-decoration-color 150ms ease, color 150ms ease"
    },
    "a:hover": {
      "textDecorationColor": "currentColor"
    },
    "small": {
      "fontSize": "token:text.sm"
    },
    "strong": {
      "fontWeight": "token:weight.semibold"
    },
    "figcaption": {
      "fontSize": "token:text.sm",
      "lineHeight": "1.45",
      "color": "token:color.muted"
    },
    "blockquote": {
      "fontFamily": "token:font.serif",
      "fontSize": "token:text.3xl",
      "lineHeight": "1.12",
      "letterSpacing": "-0.005em"
    },
    "hr": {
      "borderColor": "token:color.border"
    },
    "code": {
      "fontFamily": "token:font.mono",
      "fontSize": "0.875em"
    },
    "::selection": {
      "backgroundColor": "token:color.accent/25"
    },
    ":focus-visible": {
      "outline": "2px solid token:color.accent",
      "outlineOffset": "3px"
    },
    ".display": {
      "fontFamily": "token:font.display",
      "fontSize": "token:text.display",
      "lineHeight": "token:leading.display",
      "letterSpacing": "token:tracking.display",
      "fontWeight": "token:weight.medium",
      "textWrap": "balance"
    },
    ".display em": {
      "fontFamily": "token:font.serif",
      "fontStyle": "italic",
      "fontWeight": "token:weight.regular",
      "letterSpacing": "-0.02em"
    },
    ".lede": {
      "fontSize": "token:text.2xl",
      "lineHeight": "1.3",
      "letterSpacing": "token:tracking.snug",
      "textWrap": "pretty"
    },
    ".lede em": {
      "fontFamily": "token:font.serif",
      "fontStyle": "italic",
      "letterSpacing": "0",
      "fontSize": "1.08em"
    },
    ".eyebrow": {
      "fontSize": "token:text.sm",
      "lineHeight": "1.4",
      "fontWeight": "token:weight.medium",
      "color": "token:color.muted",
      "letterSpacing": "0.005em"
    },
    ".meta": {
      "fontSize": "token:text.sm",
      "lineHeight": "1.4",
      "color": "token:color.muted",
      "fontVariantNumeric": "tabular-nums"
    },
    ".quiet-link": {
      "textDecorationLine": "none"
    },
    ".quiet-link:hover": {
      "textDecorationLine": "underline"
    }
  },
  "prose": {
    "spacing": {
      "blocks": "1.25em",
      "headings": "2.2em",
      "afterHeadings": "0.7em",
      "items": "0.4em"
    },
    "h2": {
      "fontSize": "token:text.3xl"
    },
    "h3": {
      "fontSize": "token:text.xl"
    },
    "p": {
      "fontSize": "token:text.lg",
      "lineHeight": "1.62"
    },
    "li": {
      "fontSize": "token:text.lg",
      "lineHeight": "1.6"
    },
    "blockquote": {
      "fontSize": "token:text.3xl",
      "marginBlock": "1.6em"
    },
    "figure": {
      "marginBlock": "2.25em"
    },
    "a": {
      "textDecorationColor": "token:color.accent/60"
    }
  },
  "buttons": {
    "primary": {
      "base": {
        "backgroundColor": "token:color.primary",
        "color": "token:color.primary-foreground",
        "borderRadius": "token:radius.full",
        "fontWeight": "token:weight.medium",
        "letterSpacing": "-0.005em"
      },
      "hover": {
        "backgroundColor": "token:color.primary/85"
      }
    },
    "secondary": {
      "base": {
        "backgroundColor": "transparent",
        "color": "token:color.foreground",
        "borderColor": "token:color.foreground/25",
        "borderRadius": "token:radius.full",
        "fontWeight": "token:weight.medium"
      },
      "hover": {
        "borderColor": "token:color.foreground",
        "backgroundColor": "token:color.foreground/5"
      }
    },
    "ghost": {
      "base": {
        "backgroundColor": "transparent",
        "color": "token:color.foreground",
        "borderRadius": "token:radius.full",
        "fontWeight": "token:weight.medium"
      },
      "hover": {
        "backgroundColor": "token:color.foreground/6"
      }
    },
    "link": {
      "base": {
        "backgroundColor": "transparent",
        "color": "token:color.foreground",
        "fontWeight": "token:weight.medium",
        "textDecorationLine": "underline",
        "textUnderlineOffset": "0.25em",
        "textDecorationColor": "token:color.foreground/35"
      },
      "hover": {
        "textDecorationColor": "token:color.foreground"
      }
    }
  },
  "fields": {
    "field": {
      "background": "token:color.raised",
      "borderColor": "token:color.border",
      "radius": "token:radius.md"
    },
    "focus": {
      "borderColor": "token:color.foreground",
      "ringColor": "token:color.accent/25"
    },
    "label": {
      "fontWeight": "token:weight.medium"
    },
    "checkbox": {
      "radius": "4px",
      "checked": "token:color.foreground"
    }
  },
  "transition": {
    "type": "fade",
    "duration": 0.25
  }
}
