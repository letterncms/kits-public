        "$value": "1.25"
      },
      "normal": {
        "$value": "1.55"
      }
    },
    "tracking": {
      "display": {
        "$value": "-0.045em"
      },
      "tight": {
        "$value": "-0.025em"
      },
      "normal": {
        "$value": "0"
      },
      "wide": {
        "$value": "0.08em"
      }
    },
    "weight": {
      "regular": {
        "$value": "400"
      },
      "medium": {
        "$value": "500"
      },
      "semibold": {
        "$value": "600"
      },
      "bold": {
        "$value": "700"
      }
    },
    "space": {
      "$type": "dimension",
      "0": {
        "$value": "0"
      },
      "1": {
        "$value": "0.25rem"
      },
      "2": {
        "$value": "0.5rem"
      },
      "3": {
        "$value": "0.75rem"
      },
      "4": {
        "$value": "1rem"
      },
      "6": {
        "$value": "1.5rem"
      },
      "8": {
        "$value": "2rem"
      },
      "12": {
        "$value": "3rem"
      },
      "16": {
        "$value": "4rem"
      },
      "24": {
        "$value": "6rem"
      },
      "gutter": {
        "$value": {
          "min": "1.25rem",
          "max": "3rem"
        }
      },
      "section": {
        "$value": {
          "min": "5rem",
          "max": "11rem"
        }
      },
      "32": {
        "$value": "8rem"
      }
    },
    "radius": {
      "none": {
        "$value": "0"
      },
      "sm": {
        "$value": "2px"
      },
      "md": {
        "$value": "4px"
      },
      "lg": {
        "$value": "10px"
      },
      "full": {
        "$value": "9999px"
      }
    },
    "shadow": {
      "sm": {
        "$value": "0 1px 2px rgb(0 0 0 / 0.06)"
      },
      "md": {
        "$value": "0 4px 16px -4px rgb(0 0 0 / 0.12)"
      },
      "lg": {
        "$value": "0 24px 48px -16px rgb(0 0 0 / 0.2)"
      }
    },
    "container": {
      "prose": {
        "$value": "40rem"
      },
      "content": {
        "$value": "78rem"
      },
      "wide": {
        "$value": "96rem"
      }
    },
    "control": {
      "$type": "dimension",
      "sm-height": {
        "$value": "2.25rem"
      },
      "sm-padding": {
        "$value": "0.75rem"
      },
      "sm-text": {
        "$value": "token:text.sm"
      },
      "md-height": {
        "$value": "2.75rem"
      },
      "md-padding": {
        "$value": "1rem"
      },
      "md-text": {
        "$value": "token:text.base"
      },
      "lg-height": {
        "$value": "3.25rem"
      },
      "lg-padding": {
        "$value": "1.25rem"
      },
      "lg-text": {
        "$value": "token:text.lg"
      }
    },
    "breakpoint": {
      "sm": {
        "$value": "640px"
      },
      "md": {
        "$value": "768px"
      },
      "lg": {
        "$value": "1024px"
      },
      "xl": {
        "$value": "1280px"
      }
    },
    "duration": {
      "fast": {
        "$value": "160ms"
      },
      "base": {
        "$value": "320ms"
      },
      "slow": {
        "$value": "900ms"
      }
    },
    "ease": {
      "out": {
        "$value": "cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "in-out": {
        "$value": "cubic-bezier(0.65, 0, 0.35, 1)"
      },
      "tide": {
        "$value": "cubic-bezier(0.7, 0, 0.15, 1)"
      }
    }
  },
  "styles": {
    "body": {
      "fontFamily": "token:font.sans",
      "fontSize": "token:text.base",
      "lineHeight": "token:leading.normal",
      "color": "token:color.foreground",
      "backgroundColor": "token:color.background",
      "fontFeatureSettings": "\"ss01\""
    },
    "h1": {
      "fontFamily": "token:font.display",
      "fontSize": "token:text.5xl",
      "lineHeight": "token:leading.none",
      "letterSpacing": "token:tracking.display",
      "fontWeight": "token:weight.medium",
      "textWrap": "balance"
    },
    "h2": {
      "fontFamily": "token:font.display",
      "fontSize": "token:text.4xl",
      "lineHeight": "token:leading.tight",
      "letterSpacing": "token:tracking.display",
      "fontWeight": "token:weight.medium",
      "textWrap": "balance"
    },
    "h3": {
      "fontSize": "token:text.xl",
      "lineHeight": "token:leading.snug",
      "letterSpacing": "token:tracking.tight",
      "fontWeight": "token:weight.medium"
    },
    "code": {
      "fontFamily": "token:font.mono",
      "fontSize": "0.9em"
    },
    "::selection": {
      "backgroundColor": "token:color.primary",
      "color": "token:color.primary-foreground"
    },
    "em": {
      "fontFamily": "token:font.serif",
      "fontStyle": "italic",
      "fontWeight": "token:weight.regular",
      "letterSpacing": "-0.03em"
    },
    "h1 em": {
      "fontSize": "1.07em"
    },
    "h2 em": {
      "fontSize": "1.07em"
    },
    "h3 em": {
      "fontSize": "1.07em"
    }
  },
  "buttons": {
    "primary": {
      "base": {
        "backgroundColor": "token:color.foreground",
        "color": "token:color.background",
        "borderRadius": "token:radius.full",
        "fontWeight": "token:weight.medium",
        "transition": "background-color 320ms cubic-bezier(0.16, 1, 0.3, 1), color 320ms cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "hover": {
        "backgroundColor": "token:color.primary",
        "color": "token:color.primary-foreground"
      }
    },
    "secondary": {
      "base": {
        "backgroundColor": "transparent",
        "color": "token:color.foreground",
        "borderColor": "token:color.foreground",
        "borderRadius": "token:radius.full",
        "fontWeight": "token:weight.medium",
        "transition": "background-color 320ms cubic-bezier(0.16, 1, 0.3, 1), color 320ms cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "hover": {
        "backgroundColor": "token:color.foreground",
        "color": "token:color.background"
      }
    }
  },
  "transition": {
    "type": "fade",
    "duration": 0.45,
    "navigation": "client"
  },
  "fonts": [
    {
      "family": "Hanken Grotesk",
      "src": "fonts/hanken-grotesk-100-900.woff2",
      "weight": "100 900",
      "style": "normal",
      "preload": true,
      "fallback": "Arial",
      "sizeAdjust": "100%",
      "ascentOverride": "100%",
      "descentOverride": "30%",
      "lineGapOverride": "0%"
    },
    {
      "family": "EB Garamond",
      "src": "fonts/eb-garamond-400-800-italic.woff2",
      "weight": "400 800",
      "style": "italic",
      "preload": true,
      "fallback": "Georgia",
      "sizeAdjust": "92%",
      "ascentOverride": "100%",
      "descentOverride": "30%",
      "lineGapOverride": "0%"
    },
    {
      "family": "IBM Plex Mono",
      "src": "fonts/ibm-plex-mono-400.woff2",
      "weight": "400",
      "style": "normal",
      "preload": false,
      "display": "swap"
    }
  ],
  "prose": {
    "h2": {
      "fontSize": "token:text.2xl",
      "letterSpacing": "token:tracking.tight",
      "lineHeight": "token:leading.snug"
    },
    "spacing": {
      "blocks": "1.15em",
      "headings": "2.4em",
      "afterHeadings": "0.8em",
      "items": "0.4em"
    }
  }
}