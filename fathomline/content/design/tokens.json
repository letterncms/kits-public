      "4xl": {
        "$value": {
          "min": "2.5rem",
          "max": "5rem"
        }
      },
      "5xl": {
        "$value": {
          "min": "3rem",
          "max": "7rem"
        }
      },
      "display": {
        "$value": {
          "min": "3.25rem",
          "max": "10.5rem"
        }
      }
    },
